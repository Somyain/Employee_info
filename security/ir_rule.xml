<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_my_custom_module_hr" model="ir.rule">
        <field name="name"> HR </field>
        <field name="model_id" ref="model_employee_info"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4,ref('my_custom_module.group_employee_hr'))]"/>
    </record>

    <record id="rule_my_custom_module_user" model="ir.rule">
        <field name="name"> User </field>
        <field name="model_id" ref="model_employee_info"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4,ref('my_custom_module.group_employee_user'))]"/>
    </record>
</odoo>