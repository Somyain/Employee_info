<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="add_employee_data" model="employee.info">
            <field name="emp_name">Sneha</field>
            <field name="gender">female</field>
            <field name="phone">7429468448</field>
            <field name="partner_email">rupali@employee.io</field>
            <field name="employee_salary">250000</field>
            <field name="job_title">software_test</field>
            <field name="work_location">ahemdabad</field>
            <field name="emergency_con">9454251742</field>
            <field name="emergency_con_name">Rao</field>
            <field name="emergency_con_relation">Brother</field>
            <field name="description">Enjoying life so hard</field>
        </record>

        <record id="employee_birthday_mails" model="ir.cron">
            <field name="name">Birthday</field>
            <field name="model_id" ref="model_employee_info"/>
            <!-- <field name="state">code</field> -->
            <field name="code">model._send_birthday_followup()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 02:30:00')"/>
            <field name="priority">5</field>
            <field name="active">True</field>
        </record>

        <record id="birthday_mail_template" model="mail.template">
            <field name="name">Birthday Wish Email Template</field>
            <field name="model_id" ref="model_employee_info"/>
            <!-- <field name="email_from">snehakhandelwal125@gmail.com</field> -->
            <field name="email_to">{{object.partner_email }}</field>
            <field name="subject">Many many returns of the day {{ object.emp_name}}</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; font-size: 14px; color: #000000;">
                    <p> Dear
                        <strong>
                            <t t-esc="object.emp_name"/>
                        </strong>
                    </p>
                    <p>
                        We hope you are doing well and have a great day ,
                        here are some small gift for you !!...
                    </p>
                    <table style="border: 1px solid #080101; border-collapse: collapse; width: 100%; margin-top: 10px;">
                        <thead>
                            <tr style="background-color: #b1712d97; text-align: left;">
                                <th style="border: 1px solid #000000; padding: 8px;">Cake 🎉🎉🎉</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </field>
        </record>

    </data>
</odoo>

