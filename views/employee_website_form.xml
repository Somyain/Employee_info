<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="menu_employee_form" model="website.menu">
        <field name="name">Employee Registration</field>
        <field name="url">/employee/info</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" eval="60"/>
    </record>

    <template id="employee_info_form_page">
        <t t-call="website.layout">
            <div id="wrap" class="container mt-5">

                <h2>Employee Registration</h2>

                <t t-if="error">
                    <div class="alert alert-danger">
                        <t t-esc="error"/>
                    </div>
                </t>
                
                <t t-if="success">
                    <div class="modal fade show"
                        id="successModal"
                        tabindex="-1"
                        style="display:block; background:rgba(0,0,0,0.5);">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">

                                <div class="modal-header">
                                    <h5 class="modal-title">Thank You</h5>
                                    <button type="button"
                                            class="btn-close"
                                            onclick="closeSuccessModal()"></button>
                                </div>

                                <div class="modal-body text-center">
                                    <p>
                                        Thank you
                                        <strong>
                                            <t t-if="emp_name">
                                                <t t-esc="emp_name"/>
                                            </t>
                                        </strong>,
                                    </p>
                                    <p>Your registration has been submitted successfully.</p>
                                </div>

                                <div class="modal-footer">
                                    <button class="btn btn-primary"
                                            onclick="closeSuccessModal()"
                                            id="closeSuccessBtn">
                                        OK
                                    </button>
                                </div>

                            </div>
                        </div>
                    </div>
                </t>

                <form id="employeeForm" action="/employee/info/submit" method="post">

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label>Name *</label>
                            <input type="text" name="emp_name" class="form-control" required="1"/>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label>Email *</label>
                            <input type="email" name="partner_email" class="form-control" required="1"/>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label>Phone *</label>
                            <input type="text" name="phone" class="form-control" required="1" maxlength="10" pattern="[0-9]{10}"
                                inputmode="numeric" oninput="this.value=this.value.replace(/[^0-9]/g,'').slice(0,10)"/>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label>Gender *</label>
                            <select name="gender" class="form-control">
                                <option value="">Select</option>
                                <option value="male">
                                    Male</option>
                                <option value="female">
                                    Female</option>
                                <option value="other">
                                    Other</option>
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label>Job Title</label>
                            <select name="job_title" class="form-control">
                                <option value="">Select</option>
                                <option value="software_dev">
                                    Software Developer</option>
                                <option value="software_test">
                                    Software Tester</option>
                                <option value="hr">
                                    HR</option>
                                <option value="ai/ml">
                                    AI/ML</option>
                                <option value="odoo_professional">
                                    Odoo Professional</option>
                                <option value="none">
                                    None</option>
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label>Annual Income *</label>
                            <input type="number" name="employee_salary" class="form-control" required="1"/>
                        </div>

                        <div class="col-12 mb-3">
                            <label>Description</label>
                            <textarea name="description" class="form-control"/>
                        </div>

                        <div class="col-12 text-end">
                            <button type="submit" class="btn btn-primary">
                                Submit
                            </button>
                        </div>
                    </div>

                </form>
            </div>
        </t>

        <script>
            document.addEventListener("DOMContentLoaded", function () {

                const btn = document.getElementById("closeSuccessBtn");

                if (btn) {
                    btn.addEventListener("click", function () {
                        window.location.href = "/employee/info";
                    });
                }

            });
        </script>

    </template>

</odoo>