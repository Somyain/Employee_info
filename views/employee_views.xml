<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="employee_info_kanban" model="ir.ui.view">
        <field name="name">employee.info.kanban</field>
        <field name="model">employee.info</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click" style="position: relative; padding-right: 120px; min-height: 150px;">
                            <div style="position: absolute; top: 0; right: 0; width: 100px; height: 100px;">
                                <field name="employee_image" widget="image"/>
                            </div>
                            <strong>
                                <h1>
                                    <field name="emp_name"/>
                                </h1>
                                <field name="reference_number"/>
                            </strong>
                            <div style="display: flex; justify-content: space-between;">
                                <field name="gender"/>
                                <field name="date_of_birth"/>
                            </div>
                            <div style="display: flex; justify-content: space-between;">
                                <field name="age"/>
                                <field name="job_title"/>
                            </div>
                            <div>
                                <field name="department_id"/>
                            </div>
                            <div>
                                <field name="user_id" string="Reporting manager"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="employee_info_list" model="ir.ui.view">
        <field name="name">employee.info.list</field>
        <field name="model">employee.info</field>
        <field name="arch" type="xml">
            <list string="cases">
                <field name="reference_number"/>
                <field name="emp_name"/>
                <field name="phone"/>
                <field name="partner_email" widget="email"/>
                <field name="date_of_birth"/>
                <field name="age"/>
                <field name="gender"/>
                <field name="date_of_birth"/>
            </list>
        </field>
    </record> 

    <record id="employee_info_form" model="ir.ui.view">
        <field name ="name">employee.info.form</field>
        <field name="model">employee.info</field>
        <field name="arch" type="xml">
            <form string="Employee Details">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="reference_number"/>
                            <group>
                                <field name="emp_name" string="Name"/>
                            </group>
                        </h1>
                    </div>
                    <div style="position: absolute; top: 0; right: 0; width: 150px; height: 150px;">
                        <field name="employee_image" widget="image"/>
                    </div>
                    <group>
                        <group>
                            <field name="date_of_birth"/>
                            <field name="age"/>
                            <field name="gender"/>
                        </group>
                        <group>
                            <field name="phone"/>
                            <field name="partner_email" widget="email"/>
                            <field name="joining_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Employee Detail">
                            <group>
                                <field name="description" string="About yourself"/>
                                <field name="job_title" string="Job Title"/>
                                <field name="work_location" string="Work Location"/>
                                <field name="employee_salary" string="Employee Monthly income"/>
                                <field name="user_id" string="Reporting Manager"/>
                            </group>
                        </page>
                        <page string="Employee emergency details">
                            <group>
                                <field name="emergency_con_name" string="Emergency contact name"/>
                                <field name="emergency_con" string="Emergency contact"/>
                                <field name="emergency_con_relation" string="Relation with emergency contact"/>
                            </group>
                        </page>
                        <page string="Skill">
                            <group>
                                <field name="employee_skill_ids"
                                    mode="list"
                                    string="Employee Skill"
                                >   
                                    <list editable="bottom">
                                        <field name="skill_name"/>
                                        <field name="skill_level"/>
                                    </list>
                                </field>
                                <field name="department_id" ref="employee.department" string="Department"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="employee_info_calendar" model="ir.ui.view">
        <field name="name">employee.info.calendar</field>
        <field name="model">employee.info</field>
        <field name="arch" type="xml">
            <calendar date_start="date_of_birth" string="Employee Joining Calendar"
                    mode="month" color="emp_name">
                    <field name="emp_name"/>
                    <field name="joining_date"/>
                    <field name="reference_number"/>
            </calendar>
        </field>
    </record>
    
    <record id="employee_info_graph" model="ir.ui.view">
        <field name="name">employee.info.graph</field>
        <field name="model">employee.info</field>
        <field name="arch" type="xml">
            <graph string="Employee Overview" type="bar" stacked="1">
                <field name="employee_salary" type="row"/>
            </graph>
        </field>
    </record>

    <record id="employee_action" model="ir.actions.act_window">
        <field name="name">Employee</field>
        <field name="res_model">employee.info</field>
        <field name="view_mode">list,form,kanban,calendar,graph</field>
    </record>

</odoo>